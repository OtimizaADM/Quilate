# Stack de integração (Evolution API + N8N). Copie para integracao/.env.

# Chave global da Evolution API (autentica chamadas de gerência). openssl rand -hex 24
EVOLUTION_API_KEY=""
# Senha do Postgres da Evolution. openssl rand -hex 12
EVOLUTION_POSTGRES_PASSWORD=""

# Chave de criptografia das credenciais do N8N (NUNCA troque depois de criada). openssl rand -hex 24
N8N_ENCRYPTION_KEY=""

# Fuso e URLs
TIMEZONE="America/Sao_Paulo"
# Base do Quilate que o N8N usa para chamar /api/integracao/*
#   - Local (Quilate no host via npm run dev): http://host.docker.internal:3000
#   - VPS: a URL interna/externa do app Quilate
QUILATE_BASE_URL="http://host.docker.internal:3000"
# Em produção (VPS), o host público do N8N e a URL de webhook (atrás de HTTPS/proxy)
N8N_HOST="localhost"
N8N_WEBHOOK_URL="http://localhost:5678/"

# Lembrete: o token do Quilate (INTEGRACAO_API_TOKEN, do ../.env) é configurado
# como credencial Bearer DENTRO do N8N (UI), não aqui.
