# Conexão do PostgreSQL (Docker Compose usa estes valores por padrão)
DATABASE_URL="postgresql://quilate:quilate@localhost:5433/quilate"

# Pasta no disco do servidor onde as imagens dos modelos são salvas
UPLOAD_DIR="./uploads"

# ===== Auth.js (usuário único) =====
# Gerar segredo: openssl rand -base64 32
AUTH_SECRET=""
# Usuário de login
AUTH_USERNAME="admin"
# Hash bcrypt da senha. Gerar: npm run auth:hash -- "SUA_SENHA"
# ATENÇÃO: o hash contém '$'. Escape cada um como \$ aqui (o Next.js expande $ no .env),
# senão o login falha. Ex.: AUTH_PASSWORD_HASH="\$2b\$10\$abc..."
AUTH_PASSWORD_HASH=""

# ===== Integração (N8N/WhatsApp) =====
# Token Bearer das rotas /api/integracao/*. Gerar: openssl rand -hex 32
INTEGRACAO_API_TOKEN=""
