  "views": {
    "public.saldos": {
      "columns": {
        "variacao_id": {
          "name": "variacao_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "codigo": {
          "name": "codigo",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "saldo": {
          "name": "saldo",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n    select\n      v.id as variacao_id,\n      v.codigo,\n      coalesce(sum(case when m.tipo_mov = 'entrada' then m.quantidade\n                        when m.tipo_mov = 'saida'   then -m.quantidade end), 0) as saldo\n    from variacoes v\n    left join movimentacoes m on m.variacao_id = v.id\n    group by v.id, v.codigo\n  ",
      "name": "saldos",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
